```
```c
/* fsm.c */
#include "fsm.h"
void fsm_init(FSM* f) {
f->cycles = 0; f->budget = WCET_CYCLES;
f->tile_id = TILE_UNKNOWN; f->error = ERR_NONE;
}
void fsm_tick(FSM* f) {
f->cycles++;
if (f->cycles > f->budget) { f->error = ERR_WCET; }
}
