src/main.c
```c
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>
#include "st_config.h"
#include "harvest.h"
#include "triage.h"
#include "tiles.h"
#include "fsm.h"
/* Host "cycle" counter — nanoseconds. On MCU, use DWT->CYCCNT. */
static uint64_t host_cycles(void) {
struct timespec ts;
clock_gettime(CLOCK_MONOTONIC, &ts);
return (uint64_t)ts.tv_sec * 1000000000ULL + ts.tv_nsec;
}
/* Single deterministic pipeline. Decision + render, one function. */
static uint16_t st1024(const char* input, char* out, size_t out_size,
uint16_t* tile_out, uint32_t* cycles_out) {
FSM fsm; fsm_init(&fsm);
uint64_t t0 = host_cycles();
char norm[MAX_INPUT_LEN];
uint16_t n = harvest(input, norm, sizeof(norm));
fsm_tick(&fsm);
if (n == 0) { fsm.error = ERR_EMPTY; goto done; }
TriageResult tr = triage(norm, n);
fsm_tick(&fsm);
if (tr.tile_id == TILE_UNKNOWN) { fsm.error = ERR_AMBIG; goto done; }
fsm.tile_id = tr.tile_id;
/* Render — deterministic. Placeholder for the tiny transformer. */
snprintf(out, out_size, "%s", TILE_SENTENCE[tr.tile_id]);
fsm_tick(&fsm);
done:
if (cycles_out) *cycles_out = (uint32_t)(host_cycles() - t0);
if (tile_out) *tile_out = fsm.tile_id;
return fsm.error;
}
static void interactive(void) {
char buf[MAX_INPUT_LEN], out[256];
fprintf(stderr, "ST-T1024 first artifact. Ctrl-D to exit.\n");
while (fgets(buf, sizeof(buf), stdin)) {
size_t n = strlen(buf);
if (n && buf[n-1] == '\n') buf[n-1] = '\0';
uint16_t tile; uint32_t cyc;
uint16_t err = st1024(buf, out, sizeof(out), &tile, &cyc);
if (err == ERR_AMBIG) printf("AMBIG (%u ns)\n", cyc);
else if (err == ERR_EMPTY) printf("EMPTY (%u ns)\n", cyc);
else if (err == ERR_WCET) printf("WCET (%u ns)\n", cyc);
else printf("%s [tile %u, %u ns]\n", out, tile, cyc);
}
}
static void bench(const char* path) {
FILE* f = fopen(path, "r"); if (!f) { perror("fopen"); exit(1); }
char buf[MAX_INPUT_LEN], out[256];
uint32_t max_c = 0; uint64_t tot = 0, cnt = 0;
while (fgets(buf, sizeof(buf), f)) {
size_t n = strlen(buf);
if (n && buf[n-1] == '\n') buf[n-1] = '\0';
uint32_t cyc;
st1024(buf, out, sizeof(out), NULL, &cyc);
if (cyc > max_c) max_c = cyc;
tot += cyc; cnt++;
}
fclose(f);
printf("Queries: %llu\n", (unsigned long long)cnt);
printf("Max: %u ns\n", max_c);
printf("Mean: %.1f ns\n", (double)tot / (double)cnt);
printf("Budget: %u\n", WCET_CYCLES);
printf("Pass: %s\n", max_c <= WCET_CYCLES ? "YES" : "NO");
}
int main(int argc, char** argv) {
if (argc == 1) interactive();
else if (argc == 3 && !strcmp(argv[1], "--bench")) bench(argv[2]);
else { fprintf(stderr, "usage: %s [--bench FILE]\n", argv[0]); return 1; }
return 0;
}
