```c
/* triage.c */
#include "triage.h"
#include "tiles.h"
#include <string.h>
static int lev_bounded(const char* a, size_t la,
const char* b, size_t lb, int max) {
if (la > lb + (size_t)max || lb > la + (size_t)max) return max + 1;
if (lb >= 64) return max + 1;
int prev[64], curr[64];
for (size_t j = 0; j <= lb; ++j) prev[j] = (int)j;
for (size_t i = 1; i <= la; ++i) {
curr[0] = (int)i;
int row_min = curr[0];
for (size_t j = 1; j <= lb; ++j) {
int cost = (a[i-1] == b[j-1]) ? 0 : 1;
int m = prev[j] + 1;
if (curr[j-1] + 1 < m) m = curr[j-1] + 1;
if (prev[j-1] + cost < m) m = prev[j-1] + cost;
curr[j] = m;
if (m < row_min) row_min = m;
}
if (row_min > max) return max + 1;
memcpy(prev, curr, sizeof(int) * (lb + 1));
}
return prev[lb];
}
TriageResult triage(const char* norm, size_t len) {
TriageResult r = { TILE_UNKNOWN, 0 };
for (int i = 0; i < NUM_TILES; ++i)
if (strcmp(norm, TILE_CANON[i]) == 0)
{ r.tile_id = (uint16_t)i; r.distance = 0; return r; }
int best_dist = 4, best_idx = -1, ties = 0;
for (int i = 0; i < NUM_TILES; ++i) {
int d = lev_bounded(norm, len, TILE_CANON[i],
strlen(TILE_CANON[i]), 3);
if (d < best_dist) { best_dist = d; best_idx = i; ties = 0; }
else if (d == best_dist && best_idx >= 0) ties++;
}
if (best_idx < 0 || ties > 0) return r;
r.tile_id = (uint16_t)best_idx;
r.distance = (uint16_t)best_dist;
return r;
}
