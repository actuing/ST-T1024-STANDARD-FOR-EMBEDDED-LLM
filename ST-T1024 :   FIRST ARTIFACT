/* harvest.c */
#include "harvest.h"
#include <ctype.h>
uint16_t harvest(const char* in, char* out, size_t out_size) {
size_t j = 0;
int in_space = 1;
for (const char* p = in; *p && j + 1 < out_size; ++p) {
unsigned char c = (unsigned char)*p;
if (c == ' ' || c == '\t' || c == '\n' || c == '\r') {
if (!in_space && j > 0) out[j++] = ' ';
in_space = 1;
} else if (c >= 0x20 && c < 0x7F) {
out[j++] = (char)tolower(c);
in_space = 0;
}
}
while (j > 0 && out[j-1] == ' ') j--;
out[j] = '\0';
return (uint16_t)j;
}
