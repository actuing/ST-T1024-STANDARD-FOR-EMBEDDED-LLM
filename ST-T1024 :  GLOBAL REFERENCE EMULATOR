def build_system() -> ST1024:
    common = {"GENERAL": "Physics does not negotiate."}

    tiles = [
        DomainTile(0, "THERMODYNAMICS",
            keywords=["thermo", "entropy", "heat", "energy"],
            facts={**common,
                "ENTROPY": "Total entropy of an isolated system always increases.",
                "ENERGY":  "Energy cannot be created or destroyed, only converted."}),
        DomainTile(1, "FINANCE",
            keywords=["finance", "debt", "interest", "deficit"],
            facts={**common,
                "DEBT":     "Debt is a claim on future output.",
                "INTEREST": "Interest is a fixed charge, not a discretionary item."}),
        DomainTile(2, "WAR",
            keywords=["war", "defense", "military", "conflict"],
            facts={**common,
                "COST":     "Wars are politically costless when debt-financed.",
                "HARNESS":  "A war surtax restores the cost to the present."}),
        DomainTile(3, "CAPTURE",
            keywords=["capture", "donor", "campaign", "lobby"],
            facts={**common,
                "DONOR":    "Candidates need money; donors expect alignment.",
                "REMEDY":   "Sever the pipeline before any fiscal remedy passes."}),
    ]
    return ST1024(tiles)


