def test_budget_integrity() -> None:
    assert Arch.budget_sum() == Arch.WCET_CYCLES
    print(f"✓ [V6] budget integrity — {Arch.budget_sum()} = WCET")


def test_tile_independence() -> None:
    s = build_system()
    assert s.audit_tile_independence(), "tiles share ROM"
    s.tiles[0].rom.facts["PROBE"] = "CORRUPTED"
    assert "PROBE" not in s.tiles[1].rom.facts, "cross-tile leak"
    print("✓ [V1] tile independence — no shared ROM")


def test_ternary_arithmetic() -> None:
    def d(a, b):
        ap, an = pack_trits([a]); bp, bn = pack_trits([b])
        return ternary_dot_packed(ap, an, bp, bn)
    assert d( 1,  1) ==  1
    assert d(-1, -1) ==  1
    assert d( 1, -1) == -1
    assert d(-1,  1) == -1
    assert d( 0,  1) ==  0
    print("✓ [V3] ternary arithmetic — XNOR + popcount, no `*`")


def test_determinism() -> None:
    a, b = build_system(), build_system()
    q = "what is entropy?"
    ta, tb = a.process(q), b.process(q)
    assert ta.tile_id == tb.tile_id, (
        f"nondeterministic routing: {ta.tile_id} vs {tb.tile_id}"
    )
    print(f"✓ [V2] determinism — both runs routed to tile {ta.tile_id}")


def test_refusal_ambiguous() -> None:
    s = build_system()
    tr = s.process("xyzzy plugh frobnicate")
    assert tr.status == "REFUSE"
    assert tr.refusal_code == "0x-AMBIG"
    print("✓ [V4] refusal — 0x-AMBIG on unknown domain")


def test_wcet_branch_reachable() -> None:
    s = build_system()
    tr = s.process("what is entropy?", _inject_overrun=10_000)
    assert tr.status == "REFUSE"
    assert tr.refusal_code == "0x-WCET-EXCEEDED"
    print("✓ [V5] WCET branch reachable — injected overrun refused")


def test_happy_path() -> None:
    s = build_system()
    tr = s.process("what is entropy?")
    assert tr.status == "OK"
    assert tr.tile_id == 0
    assert tr.refusal_code is None
    print(f"✓ [OK] happy path — entropy routed to tile 0, "
          f"{tr.total_cycles} cycles")


