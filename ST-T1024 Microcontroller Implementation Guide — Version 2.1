Phase 3 — Ternary Engine

Dual-plane encoding: each trit is two bits, (pos, neg).

pos neg value
0 0 0
1 0 +1
0 1 −1
1 1 invalid — fail-closed

```c
/* ternary_engine.h */
#ifndef TERNARY_ENGINE_H
#define TERNARY_ENGINE_H

#include <stdint.h>

typedef struct {
    uint32_t* pos;    /* bit-plane: +1 positions */
    uint32_t* neg;    /* bit-plane: -1 positions */
    uint16_t  len;    /* number of trits */
    uint16_t  words;  /* 32-bit words per plane */
} TernaryVec;

uint8_t ternary_validate(const TernaryVec* v);
int32_t ternary_dot(const TernaryVec* a, const TernaryVec* b);
int8_t  ternary_mul_scalar(int8_t a, int8_t b, uint8_t* valid);

#endif
```

```c
/* ternary_engine.c */
#include "ternary_engine.h"

uint8_t ternary_validate(const TernaryVec* v) {
    for (uint16_t i = 0; i < v->words; ++i) {
        if (v->pos[i] & v->neg[i]) return 0;   /* both planes set = invalid */
    }
    return 1;
}

int32_t ternary_dot(const TernaryVec* a, const TernaryVec* b) {
    if (a->words != b->words) return 0;

    int32_t acc = 0;
    for (uint16_t i = 0; i < a->words; ++i) {
        const uint32_t ap = a->pos[i], an = a->neg[i];
        const uint32_t bp = b->pos[i], bn = b->neg[i];

        /* (+1)*(+1) and (-1)*(-1) contribute +1 */
        acc += (int32_t)__builtin_popcount(ap & bp);
        acc += (int32_t)__builtin_popcount(an & bn);

        /* (+1)*(-1) and (-1)*(+1) contribute -1 */
        acc -= (int32_t)__builtin_popcount(ap & bn);
        acc -= (int32_t)__builtin_popcount(an & bp);
    }
    return acc;
}

int8_t ternary_mul_scalar(int8_t a, int8_t b, uint8_t* valid) {
    if (a < -1 || a > 1 || b < -1 || b > 1) {
        *valid = 0;
        return 0;
    }
    *valid = 1;
    return (int8_t)(a * b);   /* small-int multiply; not in the hot loop */
}
```

Why this matters. No floating-point. No multipliers in the hot loop. The hot loop is ternary_dot, which uses popcount only.

Note on popcount. ARMv7-M (Cortex-M7) has no hardware population count. __builtin_popcount compiles to a software routine. On Cortex-M7 at 200 MHz, a 256-trit dot product takes ~600–800 cycles — not the ~180 cycles a hardware popcount would achieve. Hardware popcount requires ARMv8.1-M or a custom RISC-V extension. Measure your platform; do not assume.

Phase 4 — FSM Scheduler

```c
/* fsm_scheduler.h */
#ifndef FSM_SCHEDULER_H
#define FSM_SCHEDULER_H

#include <stdint.h>
#include "st_config.h"

typedef enum {
    STATE_IDLE      = 0,
    STATE_HARVEST   = 1,
    STATE_TRIAGE    = 2,
    STATE_SCHEDULE  = 3,
    STATE_EXECUTE   = 4,
    STATE_POWERDOWN = 5,
    STATE_ERROR     = 6
} FSMState;

typedef struct {
    FSMState state;
    uint32_t cycle_counter;
    uint32_t cycle_budget;
    uint16_t active_tile;
    uint16_t error_code;
    uint8_t  done;
} FSM;

void    fsm_init(FSM* fsm);
void    fsm_tick(FSM* fsm);
uint8_t fsm_advance(FSM* fsm);
void    fsm_fail(FSM* fsm, uint16_t err);

#endif
```

```c
/* fsm_scheduler.c */
#include "fsm_scheduler.h"

/* Reference implementation: software tick advances the counter.
 * Silicon: a hardware cycle counter increments cycle_counter directly,
 * and FSM_TICK_HARDWARE is defined to prevent double-counting. */
#ifndef FSM_TICK_HARDWARE
#define FSM_TICK_HARDWARE 0
#endif

void fsm_init(FSM* fsm) {
    fsm->state         = STATE_IDLE;
    fsm->cycle_counter = 0;
    fsm->cycle_budget  = WCET_CYCLES;
    fsm->active_tile   = TILE_UNKNOWN;
    fsm->error_code    = ERR_NONE;
    fsm->done          = 0;
}

void fsm_fail(FSM* fsm, uint16_t err) {
    fsm->state      = STATE_ERROR;
    fsm->error_code = err;
    fsm->done       = 1;
}

void fsm_tick(FSM* fsm) {
#if !FSM_TICK_HARDWARE
    /* Reference build: software advances the counter.
     * Silicon build: hardware timer advances the counter, and this
     * function is a no-op to prevent double-counting. */
    fsm->cycle_counter++;
#endif
    if (fsm->cycle_counter > fsm->cycle_budget) {
        fsm_fail(fsm, ERR_WCET);
    }
}

uint8_t fsm_advance(FSM* fsm) {
    if (fsm->done) return 1;

    fsm_tick(fsm);
    if (fsm->state == STATE_ERROR) return 1;

    switch (fsm->state) {
        case STATE_IDLE:      fsm->state = STATE_HARVEST;   break;
        case STATE_HARVEST:   fsm->state = STATE_TRIAGE;    break;
        case STATE_TRIAGE:    fsm->state = STATE_SCHEDULE;  break;
        case STATE_SCHEDULE:  fsm->state = STATE_EXECUTE;   break;
        case STATE_EXECUTE:   fsm->state = STATE_POWERDOWN; break;
        case STATE_POWERDOWN: fsm->done = 1;                break;
        default:              fsm_fail(fsm, ERR_TILE);      break;
    }
    return fsm->done;
}
```

On cycle counting (corrected). In v2.0, both fsm_tick and a hardware timer were described as advancing the counter — a double-count. In v2.1, the build mode determines which one advances. On silicon, define FSM_TICK_HARDWARE=1 and drive cycle_counter from a dedicated hardware timer — the software tick is a no-op. On the reference implementation, leave FSM_TICK_HARDWARE=0 and the software tick advances the counter.

Phase 5 — Intent Harvesting and FIS Triage

```c
/* intent_harvesting.h */
#ifndef INTENT_HARVESTING_H
#define INTENT_HARVESTING_H

#include <stdint.h>
#include "st_config.h"

#define MAX_QUERY_LEN 256

typedef struct {
    uint8_t  raw[MAX_QUERY_LEN];
    uint16_t length;
    uint32_t hash;
} QueryIntent;

QueryIntent harvest_intent(const char* input);

#endif
```

```c
/* intent_harvesting.c */
#include "intent_harvesting.h"

/* FNV-1a: deterministic, cheap, no FP. */
static uint32_t fnv1a(const uint8_t* data, uint16_t len) {
    uint32_t h = 0x811C9DC5u;
    for (uint16_t i = 0; i < len; ++i) {
        h ^= data[i];
        h *= 0x01000193u;
    }
    return h;
}

QueryIntent harvest_intent(const char* input) {
    QueryIntent q = {0};
    uint16_t n = 0;

    for (const char* p = input; *p && n < MAX_QUERY_LEN; ++p) {
        uint8_t c = (uint8_t)*p;
        if (c >= 'A' && c <= 'Z') c = (uint8_t)(c + 32);
        q.raw[n++] = c;
    }
    q.length = n;
    q.hash   = fnv1a(q.raw, n);
    return q;
}
```

FIS triage routes the intent to a tile. The rule set is a finite table, formally verifiable in TLA+ (see AGENTIC ST-T1024 TLA+). The routing function must be total: every hash maps to exactly one tile, or to TILE_UNKNOWN → ERR_AMBIG.

```c
/* fis_triage.h */
#ifndef FIS_TRIAGE_H
#define FIS_TRIAGE_H

#include <stdint.h>
#include "st_config.h"
#include "intent_harvesting.h"

typedef struct {
    uint16_t tile_id;
    uint8_t  confidence;
} TriageResult;

TriageResult fis_triage(const QueryIntent* q);

#endif
```

```c
/* fis_triage.c — table-driven, deterministic, no branches on data */
#include "fis_triage.h"

/* The rule table lives in ROM (75% immutable partition). */
extern const uint16_t fis_rule_table[FIS_TABLE_SIZE];

TriageResult fis_triage(const QueryIntent* q) {
    TriageResult r = { TILE_UNKNOWN, 0 };
    uint16_t idx  = (uint16_t)(q->hash % FIS_TABLE_SIZE);
    uint16_t tile = fis_rule_table[idx];

    if (tile == TILE_UNKNOWN) return r;
    r.tile_id    = tile;
    r.confidence = 200;
    return r;
}
```

Phase 6 — Tile Memory and Power Gating

```c
/* tile_memory.h */
#ifndef TILE_MEMORY_H
#define TILE_MEMORY_H

#include <stdint.h>
#include "st_config.h"
#include "platform.h"

typedef struct {
    const uint8_t* rom;        /* immutable "brutal facts" — 525 B */
    uint8_t*       sram;       /* sovereign updates       — 175 B */
    uint16_t       tile_id;
    uint8_t        active;
} Tile;

void    tile_init(Tile* t, uint16_t id,
                  const uint8_t* rom_base, uint8_t* sram_base);
uint8_t tile_power_on(Tile* t);
void    tile_power_off(Tile* t);
uint8_t tile_sovereign_update(Tile* t, const uint8_t* packet,
                              const uint8_t* signature);

#endif
```

```c
/* tile_memory.c */
#include "tile_memory.h"

void tile_init(Tile* t, uint16_t id,
               const uint8_t* rom_base, uint8_t* sram_base) {
    t->rom     = rom_base;
    t->sram    = sram_base;
    t->tile_id = id;
    t->active  = 0;
}

uint8_t tile_power_on(Tile* t) {
    platform_power_enable(t->tile_id);
    t->active = 1;
    return 1;
}

void tile_power_off(Tile* t) {
    platform_power_disable(t->tile_id);
    t->active = 0;
}

uint8_t tile_sovereign_update(Tile* t, const uint8_t* packet,
                              const uint8_t* signature) {
    if (!sk1024_verify(packet, TILE_SRAM_B, signature)) {
        return ERR_UPDATE;
    }
    for (uint16_t i = 0; i < TILE_SRAM_B; ++i) {
        t->sram[i] = packet[i];
    }
    return ERR_NONE;
}
```

Honest note on < 5 ns wake. That figure requires on-die power switches, i.e. custom silicon. On an STM32H7, the closest equivalent is peripheral clock gating, which takes roughly 1 µs to stabilise. The guide keeps the < 5 ns claim only for the silicon target and states the MCU figure separately.

Phase 7 — Main Loop (Bare Metal)

```c
/* main.c */
#include "st_config.h"
#include "intent_harvesting.h"
#include "fis_triage.h"
#include "fsm_scheduler.h"
#include "ternary_engine.h"
#include "tile_memory.h"
#include "platform.h"

/* ROM tile descriptors — generated at build time. */
extern const uint8_t tile_rom[MAX_TILES][TILE_ROM_B];
extern uint8_t       tile_sram[MAX_TILES][TILE_SRAM_B];

static FSM  g_fsm;
static Tile g_active_tile;

static void run_one_query(void) {
    QueryIntent q  = harvest_intent(query_get());
    TriageResult tr = fis_triage(&q);

    if (tr.tile_id == TILE_UNKNOWN) {
        output_error(ERR_AMBIG);
        return;
    }

    tile_init(&g_active_tile, tr.tile_id,
              tile_rom[tr.tile_id], tile_sram[tr.tile_id]);

    fsm_init(&g_fsm);
    g_fsm.active_tile = tr.tile_id;

    if (!tile_power_on(&g_active_tile)) {
        output_error(ERR_TILE);
        return;
    }

    /* Run the FSM to completion or error. */
    while (!fsm_advance(&g_fsm)) { /* tick advances counter (see Phase 4) */ }

    tile_power_off(&g_active_tile);

    if (g_fsm.error_code == ERR_NONE) {
        output_result(g_fsm.active_tile);
    } else {
        output_error(g_fsm.error_code);
    }
}

int main(void) {
    system_clock_init();

    for (;;) {
        if (query_available()) {
            run_one_query();
        } else {
            /* Idle: all tiles at 0 V, and the core itself in low-power
             * wait-for-interrupt. Without WFI, the spin loop draws
             * full active power — defeating the power-gating claim. */
            __asm__ volatile ("wfi");
        }
    }
}
```

