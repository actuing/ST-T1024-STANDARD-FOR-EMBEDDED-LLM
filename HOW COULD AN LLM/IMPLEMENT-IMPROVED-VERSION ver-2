# IMPROVED TILE: 75% ROM + 25% SRAM + TINY TRANSFORMER
# ============================================================
class ImprovedTile:
    def __init__(self, domain_id: str, transformer: TinyTransformer):
        self.domain_id = domain_id
        self.transformer = transformer
        self.activated = False
        self.sram_context = {}
        self.power_cycles = 0

    def activate(self):
        self.activated = True
        self.power_cycles = 0

    def power_down(self):
        self.activated = False
        self.power_cycles = 0

    def execute(self, query: str, fsm: FiniteStateMachine) -> Dict:
        if not self.activated:
            return {
                "error": "Tile not activated",
                "code": ErrorCode.AMBIGUOUS,
            }

        token_ids = [ord(c) % 128 for c in query[:64]]
        if len(token_ids) < 3:
            return {
                "error": "Query too short",
                "code": ErrorCode.AMBIGUOUS,
            }

        if not fsm.transition(FiniteStateMachine.State.EXECUTE):
            return {"error": "WCET TIMEOUT", "code": ErrorCode.TIMEOUT}

        output_vec = self.transformer.forward(token_ids)

        fsm.transition(FiniteStateMachine.State.POWER_DOWN)
        self.power_down()

        return {
            "domain": self.domain_id,
            "vector": output_vec,
            "confidence": sum(output_vec) / len(output_vec),
            "cycles": fsm.total_cycles,
            "time_ns": (fsm.total_cycles * 1000) // WCET.FREQ_MHZ,
            "status": "SUCCESS",
            "code": ErrorCode.SUCCESS,
        }


