AmbiguousError ==
/\ state = "AMBIGUOUS"
/\ errorCode = "0x-AMBIG"
/\ state' = "IDLE"
/\ activeTile' = 0
/\ history' = Append(history, "ERROR: AMBIGUOUS QUERY")
/\ UNCHANGED <<query, result, cycleCounter, tilePower>>
