=======
\* STATE TRANSITIONS (The 6-Step Pipeline)
\*
======================================================================
=======
\* Step 1: Intent Harvesting
HarvestIntent ==
/\ state = "IDLE"
/\ query' \in STRING
/\ query' /= ""
/\ Len(query') <= MaxQueryLen
/\ query' = Normalize(query')
/\ state' = "HARVEST"
/\ cycleCounter' = 0
/\ history' = Append(history, "HARVEST: " \o query')
/\ UNCHANGED <<activeTile, result, errorCode, tilePower>>
\* Step 2: FIS Triage
FISTriage ==
/\ state = "HARVEST"
/\ LET tile == TriageFunction(query) IN
/\ activeTile' = tile
/\ IF tile = 0 THEN
/\ state' = "AMBIGUOUS"
/\ errorCode' = "0x-AMBIG"
ELSE
/\ state' = "TRIAGE"
/\ errorCode' = ""
/\ cycleCounter' = cycleCounter + 10 \* 10 cycles for triage
/\ history' = Append(history, "TRIAGE: tile " \o ToString(activeTile'))
/\ UNCHANGED <<query, result, tilePower>>
\* Step 3: FSM Scheduling
FSMSchedule ==
/\ state = "TRIAGE"
/\ activeTile /= 0
/\ state' = "SCHEDULE"
/\ cycleCounter' = cycleCounter + 5 \* 5 cycles for scheduling
/\ history' = Append(history, "SCHEDULE: powering tile " \o ToString(activeTile))
/\ UNCHANGED <<query, result, errorCode, tilePower>>
\* Step 4: Tile Activation (Power-on)
TileActivation ==
/\ state = "SCHEDULE" /\ activeTile /= 0
/\ tilePower' = [t \in Tiles |-> IF t = activeTile THEN "ON" ELSE tilePower[t]]
/\ state' = "EXECUTE"
/\ cycleCounter' = cycleCounter + 1 \* 1 cycle for power-on (<5 ns)
/\ history' = Append(history, "ACTIVATE: tile " \o ToString(activeTile) \o " ON")
/\ UNCHANGED <<query, result, errorCode>>
\* Step 5: Execution (Ternary Inference)
Execute ==
/\ state = "EXECUTE"
/\ activeTile /= 0
/\ tilePower[activeTile] = "ON"
/\ LET output == TileInference(activeTile, query) IN
/\ result' = output
/\ state' = "POWERDOWN"
/\ cycleCounter' = cycleCounter + 380 \* 380 cycles for inference
/\ history' = Append(history, "EXECUTE: result = " \o result')
/\ UNCHANGED <<query, errorCode, tilePower>>
\* Step 6: 0V Power-Down
PowerDown ==
/\ state = "POWERDOWN"
/\ activeTile /= 0
/\ tilePower' = [t \in Tiles |-> IF t = activeTile THEN "OFF" ELSE tilePower[t]]
/\ state' = "IDLE"
/\ cycleCounter' = cycleCounter + 1 \* 1 cycle for power-down
/\ history' = Append(history, "POWERDOWN: tile " \o ToString(activeTile) \o " OFF")
/\ activeTile' = 0
/\ UNCHANGED <<query, result, errorCode>>
\*
