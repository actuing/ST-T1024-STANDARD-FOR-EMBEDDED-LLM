/\ cycleCounter >= MaxCycles
/\ state \notin {"IDLE", "POWERDOWN", "ERROR", "TIMEOUT"}
/\ state' = "TIMEOUT"
/\ errorCode' = "0x-TIMEOUT"
/\ history' = Append(history, "ERROR: TIMEOUT at " \o ToString(cycleCounter))
