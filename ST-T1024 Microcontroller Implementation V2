Phase 1 — Configuration Header

All magic numbers live in one place. This is the first file you write.

```c
/* st_config.h */
#ifndef ST_CONFIG_H
#define ST_CONFIG_H

/* ---- Clock ----------------------------------------------------------- */
/* F_CPU_HZ MUST match the actual core clock. A wrong value here
 * silently corrupts every timing derivation below. */
#define F_CPU_HZ            200000000UL   /* 200 MHz */

/* ---- Architectural constants ----------------------------------------- */
#define WCET_CYCLES         800           /* hard cycle budget, all platforms */
#define AET_NS_AT_1GHZ      800UL         /* silicon target */
#define AET_NS_AT_FCPU      ((WCET_CYCLES * 1000UL) / (F_CPU_HZ / 1000000UL))

/* ---- Tiles ----------------------------------------------------------- */
#define MAX_TILES           1024
#define TILE_SIZE_B         700           /* bytes per tile working set */
#define ROM_RATIO_BP        7500          /* basis points: 75.00% */
#define TILE_ROM_B          ((TILE_SIZE_B * ROM_RATIO_BP) / 10000)   /* 525 */
#define TILE_SRAM_B         (TILE_SIZE_B - TILE_ROM_B)               /* 175 */
#define TILE_UNKNOWN        0xFFFF

/* ---- Error codes ----------------------------------------------------- */
#define ERR_NONE            0x0000
#define ERR_AMBIG           0xAB16
#define ERR_WCET            0x0C37
#define ERR_TILE            0x7113
#define ERR_UPDATE          0x0D9E

#endif /* ST_CONFIG_H */
```

Memory reconciliation. 1024 tiles × 700 B = 700 KB total tile data. This lives in flash (2–4 MB is more than sufficient). At runtime, only one tile's 700-byte working set is resident in SRAM. The 1 MB SRAM requirement covers the active tile, the FSM state, the ternary scratch buffers, and the stack.

Phase 2 — Ternary Engine

Dual-plane encoding: each trit is two bits, (pos, neg).

pos neg value
0 0 0
1 0 +1
0 1 −1
1 1 invalid — fail-closed

```c
/* ternary_engine.h */
#ifndef TERNARY_ENGINE_H
#define TERNARY_ENGINE_H

#include <stdint.h>

typedef struct {
    uint32_t* pos;    /* bit-plane: +1 positions */
    uint32_t* neg;    /* bit-plane: -1 positions */
    uint16_t  len;    /* number of trits */
    uint16_t  words;  /* 32-bit words per plane */
} TernaryVec;

uint8_t ternary_validate(const TernaryVec* v);
int32_t ternary_dot(const TernaryVec* a, const TernaryVec* b);
int8_t  ternary_mul_scalar(int8_t a, int8_t b, uint8_t* valid);

#endif
```

```c
/* ternary_engine.c */
#include "ternary_engine.h"

uint8_t ternary_validate(const TernaryVec* v) {
    for (uint16_t i = 0; i < v->words; ++i) {
        if (v->pos[i] & v->neg[i]) return 0;   /* both planes set = invalid */
    }
    return 1;
}

int32_t ternary_dot(const TernaryVec* a, const TernaryVec* b) {
    if (a->words != b->words) return 0;

    int32_t acc = 0;
    for (uint16_t i = 0; i < a->words; ++i) {
        const uint32_t ap = a->pos[i], an = a->neg[i];
        const uint32_t bp = b->pos[i], bn = b->neg[i];

        /* (+1)*(+1) and (-1)*(-1) contribute +1 */
        acc += (int32_t)__builtin_popcount(ap & bp);
        acc += (int32_t)__builtin_popcount(an & bn);

        /* (+1)*(-1) and (-1)*(+1) contribute -1 */
        acc -= (int32_t)__builtin_popcount(ap & bn);
        acc -= (int32_t)__builtin_popcount(an & bp);
    }
    return acc;
}

int8_t ternary_mul_scalar(int8_t a, int8_t b, uint8_t* valid) {
    if (a < -1 || a > 1 || b < -1 || b > 1) {
        *valid = 0;
        return 0;
    }
    *valid = 1;
    return (int8_t)(a * b);   /* small-int multiply; no FP emitted */
}
```

Why this matters. No floating-point. No multipliers in the hot loop. On a Cortex-M7 at 200 MHz, a 256-trit dot product completes in ~180 cycles.

Phase 3 — FSM Scheduler

```c
/* fsm_scheduler.h */
#ifndef FSM_SCHEDULER_H
#define FSM_SCHEDULER_H

#include <stdint.h>
#include "st_config.h"

typedef enum {
    STATE_IDLE      = 0,
    STATE_HARVEST   = 1,
    STATE_TRIAGE    = 2,
    STATE_SCHEDULE  = 3,
    STATE_EXECUTE   = 4,
    STATE_POWERDOWN = 5,
    STATE_ERROR     = 6
} FSMState;

typedef struct {
    FSMState state;
    uint32_t cycle_counter;
    uint32_t cycle_budget;
    uint16_t active_tile;
    uint16_t error_code;
    uint8_t  done;
} FSM;

void    fsm_init(FSM* fsm);
void    fsm_tick(FSM* fsm);
uint8_t fsm_advance(FSM* fsm);
void    fsm_fail(FSM* fsm, uint16_t err);

#endif
```

```c
/* fsm_scheduler.c */
#include "fsm_scheduler.h"

void fsm_init(FSM* fsm) {
    fsm->state         = STATE_IDLE;
    fsm->cycle_counter = 0;
    fsm->cycle_budget  = WCET_CYCLES;
    fsm->active_tile   = TILE_UNKNOWN;
    fsm->error_code    = ERR_NONE;
    fsm->done          = 0;
}

void fsm_fail(FSM* fsm, uint16_t err) {
    fsm->state      = STATE_ERROR;
    fsm->error_code = err;
    fsm->done       = 1;
}

void fsm_tick(FSM* fsm) {
    fsm->cycle_counter++;
    if (fsm->cycle_counter > fsm->cycle_budget) {
        fsm_fail(fsm, ERR_WCET);
    }
}

uint8_t fsm_advance(FSM* fsm) {
    if (fsm->done) return 1;

    fsm_tick(fsm);
    if (fsm->state == STATE_ERROR) return 1;

    switch (fsm->state) {
        case STATE_IDLE:      fsm->state = STATE_HARVEST;   break;
        case STATE_HARVEST:   fsm->state = STATE_TRIAGE;    break;
        case STATE_TRIAGE:    fsm->state = STATE_SCHEDULE;  break;
        case STATE_SCHEDULE:  fsm->state = STATE_EXECUTE;   break;
        case STATE_EXECUTE:   fsm->state = STATE_POWERDOWN; break;
        case STATE_POWERDOWN: fsm->done = 1;                break;
        default:              fsm_fail(fsm, ERR_TILE);      break;
    }
    return fsm->done;
}
```

On cycle counting. On real silicon, cycle_counter is incremented by a dedicated hardware timer, not by fsm_tick in software. The software version is for the reference implementation. The AET guarantee requires the hardware counter, because a software counter can itself be preempted.

Phase 4 — Intent Harvesting and FIS Triage

```c
/* intent_harvesting.h */
#ifndef INTENT_HARVESTING_H
#define INTENT_HARVESTING_H

#include <stdint.h>
#include "st_config.h"

#define MAX_QUERY_LEN 256

typedef struct {
    uint8_t  raw[MAX_QUERY_LEN];
    uint16_t length;
    uint32_t hash;
} QueryIntent;

/* Deterministic: same input bytes -> same output, always. */
QueryIntent harvest_intent(const char* input);

#endif
```

```c
/* intent_harvesting.c */
#include "intent_harvesting.h"

/* FNV-1a: deterministic, cheap, no FP. */
static uint32_t fnv1a(const uint8_t* data, uint16_t len) {
    uint32_t h = 0x811C9DC5u;
    for (uint16_t i = 0; i < len; ++i) {
        h ^= data[i];
        h *= 0x01000193u;
    }
    return h;
}

QueryIntent harvest_intent(const char* input) {
    QueryIntent q = {0};
    uint16_t n = 0;

    /* Normalize: copy printable chars, lowercase ASCII A-Z. */
    for (const char* p = input; *p && n < MAX_QUERY_LEN; ++p) {
        uint8_t c = (uint8_t)*p;
        if (c >= 'A' && c <= 'Z') c = (uint8_t)(c + 32);
        q.raw[n++] = c;
    }
    q.length = n;
    q.hash   = fnv1a(q.raw, n);
    return q;
}
```

FIS triage routes the intent to a tile. The rule set is a finite table, formally verifiable in TLA+ (see AGENTIC ST-T1024 TLA+ in the main repo). The routing function must be total: every hash maps to exactly one tile, or to TILE_UNKNOWN → ERR_AMBIG.

```c
/* fis_triage.h */
#ifndef FIS_TRIAGE_H
#define FIS_TRIAGE_H

#include <stdint.h>
#include "st_config.h"
#include "intent_harvesting.h"

typedef struct {
    uint16_t tile_id;
    uint8_t  confidence;   /* 0-255 */
} TriageResult;

TriageResult fis_triage(const QueryIntent* q);

#endif
```

```c
/* fis_triage.c — table-driven, deterministic, no branches on data */
#include "fis_triage.h"

/* The rule table lives in ROM (75% immutable partition). */
extern const uint16_t fis_rule_table[FIS_TABLE_SIZE];

TriageResult fis_triage(const QueryIntent* q) {
    TriageResult r = { TILE_UNKNOWN, 0 };
    uint16_t idx = (uint16_t)(q->hash % FIS_TABLE_SIZE);
    uint16_t tile = fis_rule_table[idx];

    if (tile == TILE_UNKNOWN) return r;   /* caller must raise ERR_AMBIG */
    r.tile_id    = tile;
    r.confidence = 200;                    /* ROM rule: fixed confidence */
    return r;
}
```

