8. Validation

8.1 Determinism Test

```c
/* test_determinism.c */
static const char* inputs[] = {
    "what is 2+2",
    "define gravity",
    "ambiguous query xyzzy",
};

void test_determinism(void) {
    for (size_t i = 0; i < sizeof(inputs)/sizeof(inputs[0]); ++i) {
        uint16_t first = run_and_capture(inputs[i]);
        for (int rep = 0; rep < 1000; ++rep) {
            uint16_t again = run_and_capture(inputs[i]);
            assert(again == first);   /* must be bit-identical */
        }
    }
}
```

8.2 WCET Test

```c
void test_wcet(void) {
    /* DWT->CYCCNT on Cortex-M7 gives a hardware cycle counter. */
    DWT->CYCCNT = 0;
    run_one_query();
    uint32_t elapsed = DWT->CYCCNT;
    assert(elapsed <= WCET_CYCLES);
}
```

8.3 Hallucination Test

```c
void test_no_hallucination(void) {
    /* Feed 10,000 out-of-domain queries.
     * Every one must return ERR_AMBIG. None may return a tile result. */
    for (int i = 0; i < 10000; ++i) {
        uint16_t code = run_and_capture(random_garbage());
        assert(code == ERR_AMBIG);
    }
}
```

