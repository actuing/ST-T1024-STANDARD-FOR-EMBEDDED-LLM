```c
/* tile_memory.c */
#include "tile_memory.h"

void tile_init(Tile* t, uint16_t id,
               const uint8_t* rom_base, uint8_t* sram_base) {
    t->rom     = rom_base;
    t->sram    = sram_base;
    t->tile_id = id;
    t->active  = 0;
}

uint8_t tile_power_on(Tile* t) {
    /* Platform-specific: on silicon, write the tile's power switch.
     * On MCU, enable the peripheral clock domain. */
    platform_power_enable(t->tile_id);
    t->active = 1;
    return 1;
}

void tile_power_off(Tile* t) {
    platform_power_disable(t->tile_id);
    t->active = 0;
}

uint8_t tile_sovereign_update(Tile* t, const uint8_t* packet,
                              const uint8_t* signature) {
    if (!sk1024_verify(packet, TILE_SRAM_B, signature)) {
        return ERR_UPDATE;
    }
    for (uint16_t i = 0; i < TILE_SRAM_B; ++i) {
        t->sram[i] = packet[i];
    }
    return ERR_NONE;
}
```

Honest note on < 5 ns wake. That figure requires on-die power switches, i.e. custom silicon. On an STM32H7, the closest equivalent is peripheral clock gating, which takes roughly 1 µs to stabilise. The guide keeps the < 5 ns claim only for the silicon target and states the MCU figure separately.

Phase 6 — Main Loop (Bare Metal)

```c
/* main.c */
#include "st_config.h"
#include "intent_harvesting.h"
#include "fis_triage.h"
#include "fsm_scheduler.h"
#include "ternary_engine.h"
#include "tile_memory.h"

/* Provided by the platform port. */
extern void     system_clock_init(void);
extern uint8_t  query_available(void);
extern const char* query_get(void);
extern void     output_result(uint16_t tile_id);
extern void     output_error(uint16_t code);

/* ROM tile descriptors — generated at build time. */
extern const uint8_t tile_rom[MAX_TILES][TILE_ROM_B];
extern uint8_t       tile_sram[MAX_TILES][TILE_SRAM_B];

static FSM  g_fsm;
static Tile g_active_tile;

static void run_one_query(void) {
    QueryIntent q = harvest_intent(query_get());
    TriageResult tr = fis_triage(&q);

    if (tr.tile_id == TILE_UNKNOWN) {
        output_error(ERR_AMBIG);
        return;
    }

    tile_init(&g_active_tile, tr.tile_id,
              tile_rom[tr.tile_id], tile_sram[tr.tile_id]);

    fsm_init(&g_fsm);
    g_fsm.active_tile = tr.tile_id;

    if (!tile_power_on(&g_active_tile)) {
        output_error(ERR_TILE);
        return;
    }

    /* Run the FSM to completion or error. */
    while (!fsm_advance(&g_fsm)) { /* hardware timer ticks the counter */ }

    tile_power_off(&g_active_tile);

    if (g_fsm.error_code == ERR_NONE) {
        output_result(g_fsm.active_tile);
    } else {
        output_error(g_fsm.error_code);
    }
}

int main(void) {
    system_clock_init();

    for (;;) {
        if (query_available()) {
            run_one_query();
        }
        /* Idle: all tiles at 0 V. */
    }
}
```

