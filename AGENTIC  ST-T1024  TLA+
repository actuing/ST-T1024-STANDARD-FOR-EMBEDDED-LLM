MODULE 2 — STT1024_A2_Actions.tla

```tla
------------------------- MODULE STT1024_A2_Actions -------------------------
EXTENDS Naturals, FiniteSets, Sequences,
        STT1024_A4_State

CONSTANTS
    ActionIDs,      \* Finite action identifier set
    PredicateIDs,   \* Finite predicate identifier set
    InvariantIDs,   \* Finite invariant identifier set
    Cmax,           \* Max action cycle cost (Nat)
    Kpre,           \* Max preconditions per action (Nat)
    Kenv,           \* Max envelope predicates per action (Nat)

ASSUME FiniteActionIDs   == IsFiniteSet(ActionIDs)
ASSUME FinitePredicateIDs == IsFiniteSet(PredicateIDs)
ASSUME FiniteInvariantIDs == IsFiniteSet(InvariantIDs)
ASSUME CmaxPos           == Cmax \in Nat /\ Cmax > 0
ASSUME KprePos           == Kpre \in Nat /\ Kpre > 0
ASSUME KenvPos           == Kenv \in Nat /\ Kenv > 0

\* Predicate evaluation — abstract function from (predicate, state) to Bool.
\* In a deployment, this is instantiated with a concrete SPL interpreter.
CONSTANT eval         \* PredicateIDs × State → BOOLEAN

\* Action types (A2 §2.2)
ActionType == {"ACTUATE", "COMMUNICATE", "COMPUTE", "REQUEST_HUMAN"}

\* Action schema (A2 §2.1)
Action == [
    id           : ActionIDs,
    type         : ActionType,
    preconditions: Seq(PredicateIDs),
    effect       : State -> State,
    envelope     : Seq(PredicateIDs),
    cost_cycles  : 0..Cmax,
    cost_energy  : Nat,
    version      : Nat
]

\* Schema well-formedness (A2 §8.2)
SchemaWellFormed(a) ==
    /\ Len(a.preconditions) <= Kpre
    /\ Len(a.envelope) <= Kenv
    /\ \A i \in DOMAIN a.preconditions :
         a.preconditions[i] \in PredicateIDs
    /\ \A i \in DOMAIN a.envelope :
         a.envelope[i] \in PredicateIDs

\* Committability (A2 §9.1)
Committable(s, a) ==
    LET pre_ok == \A i \in DOMAIN a.preconditions :
                    eval[a.preconditions[i], s]
        env_ok == \A i \in DOMAIN a.envelope :
                    eval[a.envelope[i], s]
        s_next == a.effect[s]
    IN /\ pre_ok
       /\ env_ok
       /\ \A inv \in InvariantIDs : eval[inv, s_next]

\* Determinism of effect (A2 §4.2) — automatic in TLA+ functions.
EffectDeterminism ==
    \A a \in [id : ActionIDs, type : ActionType,
              preconditions : Seq(PredicateIDs),
              effect : State -> State,
              envelope : Seq(PredicateIDs),
              cost_cycles : 0..Cmax,
              cost_energy : Nat,
              version : Nat] :
        \A s1, s2 \in State : s1 = s2 => a.effect[s1] = a.effect[s2]

=============================================================================
```

