MODULE 4 — STT1024_A5_Verify.tla

```tla
-------------------------- MODULE STT1024_A5_Verify -------------------------
EXTENDS Naturals, FiniteSets, Sequences,
        STT1024_A4_State,
        STT1024_A2_Actions

\* VERIFY — the three-layer gate (A5 §4.2).
\* Returns a verdict: PASS, FAIL_PRE, FAIL_ENV, FAIL_INV.
VERIFY(s, a) ==
    LET pre_ok == \A i \in DOMAIN a.preconditions :
                    eval[a.preconditions[i], s]
        env_ok == \A i \in DOMAIN a.envelope :
                    eval[a.envelope[i], s]
        s_next == a.effect[s]
        inv_ok == \A inv \in InvariantIDs : eval[inv, s_next]
    IN IF ~pre_ok THEN "FAIL_PRE"
       ELSE IF ~env_ok THEN "FAIL_ENV"
       ELSE IF ~inv_ok THEN "FAIL_INV"
       ELSE "PASS"

\* The invariant preservation theorem (A5 §6.3).
\* If VERIFY passes, the post-state satisfies all invariants.
THEOREM A5_InvariantPreservation ==
    \A s \in State,
      a \in [id : ActionIDs, type : ActionType,
             preconditions : Seq(PredicateIDs),
             effect : State -> State,
             envelope : Seq(PredicateIDs),
             cost_cycles : 0..Cmax,
             cost_energy : Nat,
             version : Nat] :
        VERIFY(s, a) = "PASS" =>
            \A inv \in InvariantIDs : eval[inv, a.effect[s]]

=============================================================================
```

